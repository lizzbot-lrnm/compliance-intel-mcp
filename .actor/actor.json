            "fields": [
              "status",
              "screened_at_utc",
              "input",
              "summary",
              "uk_sanctions",
              "uk_registries",
              "vat_verification",
              "uk_postcode_lookup",
              "email_security_posture",
              "us_ofac_sanctions",
              "us_regulatory_recalls",
              "sources"
