          },
          "display": {
            "component": "table",
            "properties": {
              "status": {
                "label": "Status",
                "format": "text"
              },
              "screened_at_utc": {
                "label": "Screened At (UTC)",
                "format": "text"
              },
              "input": {
                "label": "Input",
                "format": "object"
              },
              "summary": {
                "label": "Risk Summary",
                "format": "object"
              },
              "sources": {
                "label": "Live Sources",
                "format": "array"
              }
            }
          }
        }
      }
    }
  }
