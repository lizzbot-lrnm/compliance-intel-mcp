{
  "actorSpecification": 1,
  "name": "uk-us-compliance-mcp-actor",
  "title": "UK & US Compliance, Sanctions, DNS & Recall Screen",
  "description": "Deterministic, zero-LLM-cost UK/US compliance & security screen: UK FCDO/OFSI sanctions, UK Charity/Companies House & GLEIF LEI registries, DNS/DMARC security posture (MX, SPF, DMARC, CAA), US OFAC SDN, and US FDA/CPSC/NHTSA recalls with live URLs & UTC timestamps.",
  "version": "0.0",
  "buildTag": "latest",
  "meta": {
    "templateId": "python-start"
  },
  "input": "./input_schema.json",
  "dockerfile": "../Dockerfile",
  "storages": {
    "dataset": {
      "actorSpecification": 1,
      "title": "Compliance & Security Screening Results",
      "views": {
        "overview": {
          "title": "Overview",
          "transformation": {
            "fields": [
              "status",
              "screened_at_utc",
              "input",
              "summary",
              "uk_sanctions",
              "uk_registries",
              "email_security_posture",
              "us_ofac_sanctions",
              "us_regulatory_recalls",
              "sources"
            ]
          },
          "display": {
            "component": "table",
            "properties": {
              "status": {
                "label": "Status",
                "format": "text"
              },
              "screened_at_utc": {
                "label": "Screened At (UTC)",
                "format": "text"
              },
              "input": {
                "label": "Input",
                "format": "object"
              },
              "summary": {
                "label": "Risk Summary",
                "format": "object"
              },
              "sources": {
                "label": "Live Sources",
                "format": "array"
              }
            }
          }
        }
      }
    }
  }
}