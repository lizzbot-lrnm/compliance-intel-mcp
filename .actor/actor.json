  "seoTitle": "UK & US Statutory Compliance & Property Tribunal MCP Server",
  "seoDescription": "15 deterministic UK/EU/US compliance tools: UK Property Tribunal RRO precedents, OFSI/OFAC sanctions, EU VIES/UK VAT, Companies House/LEI, RDAP/DMARC & PDF clauses.",
  "categories": [
    "BUSINESS",
    "LEAD_GENERATION",
    "DEVELOPER_TOOLS"
  ],
  "version": "0.3",
  "buildTag": "latest",
  "meta": {
    "templateId": "python-start"
  },
